# tekkiech-rice — sway config
# Installed by install.sh to ~/.config/sway/config
# Sway config reference: https://man.archlinux.org/man/sway.5 (i3-compatible)

set $mod Mod4
set $term foot
set $menu fuzzel
set $lock ~/.config/sway/scripts/lock.sh

# --- Palette (pitch-black, matches /mockup) ---
set $bg       #000000
set $surface  #18181a
set $border   #2a2a2c
set $borderhi #3a3a3c
set $text     #f7f7f8
set $textdim  #b3b3b8
set $textfnt  #7a7a80
set $white    #ffffff

font pango:Rubik 10

# --- Output / wallpaper ---
# Scoped to "Virtual-1" specifically, not "*" — a blanket wildcard here
# would force even a real laptop's native display to 1920x1080,
# clobbering its actual resolution. virtio-gpu's Linux driver names its
# output "Virtual-1" regardless of hypervisor (confirmed on both a QEMU
# and a Parallels VM this rice was tested on), and virtio-gpu commonly
# ships with no EDID at all — wlroots then has zero advertised modes to
# pick from and Sway fails outright with "no wl_output" until a mode is
# forced with --custom. A no-op on any real display, which is never
# named "Virtual-1".
output Virtual-1 mode --custom 1920x1080@60Hz
output * bg $bg solid_color

# --- Input ---
input "type:touchpad" {
    natural_scroll enabled
    tap enabled
}
input "type:keyboard" {
    xkb_layout us
}

# --- Look ---
default_border pixel 1
default_floating_border pixel 1
client.focused          $borderhi $surface $text $borderhi $borderhi
client.unfocused        $border   $bg      $textfnt $border $border
client.focused_inactive $border   $surface $textdim $border $border
client.urgent            #e5a1a1  #e5a1a1  $bg      #e5a1a1 #e5a1a1

gaps inner 4
gaps outer 4
smart_gaps on

# No compositor blur/rounded corners without swayfx (a fork) — see README.
# Flat panels + a border is the tradeoff for staying on vanilla, lighter sway.

# --- Autostart ---
# (no separate `exec swaybg` line — `output * bg $bg solid_color` above
# already spawns swaybg itself; a second manual one here just errored
# out on the -c argument uselessly)
exec dunst -config ~/.config/dunst/dunstrc
exec swayidle -w \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' \
    before-sleep '$lock'
exec ~/.config/sway/scripts/wob-daemon.sh
exec nm-applet --indicator
exec blueman-applet
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec ~/.config/sway/scripts/powerprofile.sh autodetect
exec ~/.config/sway/scripts/battery-watch.sh
exec_always ~/.config/sway/scripts/hidpi-scale.sh

# --- Keybindings ---
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+Shift+q exit
bindsym $mod+d exec $menu
bindsym $mod+v floating toggle
bindsym $mod+f fullscreen
bindsym $mod+l exec $lock
bindsym $mod+shift+p exec ~/.config/sway/scripts/powermenu.sh

# Laptop lid: lock (unless docked to an external monitor — clamshell
# mode) on close, and always reconcile the internal panel's power state.
# --locked on lid:off so opening the lid wakes the display even while
# already locked (otherwise you'd open the lid to a black screen).
bindswitch lid:on exec ~/.config/sway/scripts/lid-close.sh
bindswitch --locked lid:off exec ~/.config/sway/scripts/lid-close.sh

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+shift+1 move container to workspace number 1
bindsym $mod+shift+2 move container to workspace number 2
bindsym $mod+shift+3 move container to workspace number 3
bindsym $mod+shift+4 move container to workspace number 4
bindsym $mod+shift+5 move container to workspace number 5

bindsym $mod+h split h
bindsym $mod+shift+v split v
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left  resize shrink width 20px
    bindsym Right resize grow   width 20px
    bindsym Up    resize shrink height 20px
    bindsym Down  resize grow   height 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

floating_modifier $mod normal

bindsym XF86AudioRaiseVolume  exec ~/.config/sway/scripts/volume.sh up
bindsym XF86AudioLowerVolume  exec ~/.config/sway/scripts/volume.sh down
bindsym XF86AudioMute         exec ~/.config/sway/scripts/volume.sh mute
bindsym XF86MonBrightnessUp   exec ~/.config/sway/scripts/brightness.sh up
bindsym XF86MonBrightnessDown exec ~/.config/sway/scripts/brightness.sh down
bindsym XF86KbdBrightnessUp   exec ~/.config/sway/scripts/kbd-backlight.sh up
bindsym XF86KbdBrightnessDown exec ~/.config/sway/scripts/kbd-backlight.sh down

# Cycles power-saver -> balanced -> performance (whichever are actually
# available) and remembers the choice separately for AC/battery.
bindsym $mod+Shift+e exec ~/.config/sway/scripts/powerprofile.sh cycle

bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Print exec grim - | wl-copy

# --- Bar ---
bar {
    swaybar_command swaybar
    position top
    height 40
    status_command ~/.config/sway/scripts/status.sh
    font pango:Rubik 10

    colors {
        background $surface
        statusline $text
        separator  $border

        focused_workspace  $white   $white   #151515
        active_workspace   $surface $surface $text
        inactive_workspace $bg      $bg      $textfnt
        urgent_workspace    #e5a1a1 #e5a1a1  #151515
    }

    tray_output *
    tray_padding 8
    # Without this, swaybar falls back to the generic "hicolor" theme for
    # tray icons — found live: nm-applet showed a dated blue-CRT-monitor
    # icon instead of anything from Papirus.
    icon_theme Papirus-Dark
}
