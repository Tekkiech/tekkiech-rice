/* tekkiech-rice — rofi theme, matches /mockup's Launcher.dc.html */

* {
    bg:        #000000;
    surface:   #18181aee;
    border:    #3a3a3c;
    text:      #f7f7f8;
    text-dim:  #b3b3b8;
    text-faint: #7a7a80;
    white:     #ffffff;

    font: "Rubik 11";
}

window {
    background-color: @bg;
    border: 0;
    width: 600px;
    location: north;
    anchor: north;
    y-offset: 150px;
}

mainbox {
    background-color: transparent;
    padding: 0;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @border;
    border-radius: 20px 20px 0 0;
    padding: 16px 20px;
    children: [ entry ];
}

entry {
    background-color: transparent;
    text-color: @text;
    placeholder: "Search apps, files, commands…";
    placeholder-color: @text-faint;
    font: "Rubik 12";
}

listview {
    background-color: @surface;
    border: 0px 1px 1px 1px;
    border-color: @border;
    border-radius: 0 0 20px 20px;
    padding: 10px;
    lines: 8;
    spacing: 2px;
    fixed-height: false;
    dynamic: true;
}

/* Plain `element { }` / `element selected { }` got overridden by rofi's
   built-in default theme's own compound-class rules (element
   normal.normal, element selected.normal, ...), which take priority over
   a bare selector regardless of load order — found live: every row
   rendered with the default theme's white background/black text
   regardless of what the bare rules said. Writing out the compound
   selectors explicitly is the standard fix. */
element normal.normal, element alternate.normal {
    padding: 10px;
    border-radius: 12px;
    background-color: transparent;
    text-color: @text-dim;
}

element selected.normal {
    padding: 10px;
    border-radius: 12px;
    background-color: #ffffff14;
    text-color: @text;
}

element-icon {
    size: 20px;
    padding: 0 12px 0 0;
}

element-text {
    font: "Rubik 11";
    vertical-align: 0.5;
}
